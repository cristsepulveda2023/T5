. * ============================================================
. * 9. Una regresión por grupo, guardada en una matriz y exportada
. * ============================================================
. levelsof `por_grupo', local(niveles)
`"Agricultura"' `"Comercio"' `"Construcción"' `"Educación"' `"Industria"' `"Ser
> vicios"'

. local k : word count `niveles'

. matrix R = J(`k', 3, .)                     // una fila por grupo: coeficient
> e, error estándar, n

. matrix colnames R = b_`xvar' ee_`xvar' n

. 
. local i = 0

. foreach s of local niveles {
  2.     local ++i
  3.     quietly regress `depvar' `xvar' if `por_grupo' == "`s'"
  4.     matrix R[`i', 1] = _b[`xvar']
  5.     matrix R[`i', 2] = _se[`xvar']
  6.     matrix R[`i', 3] = e(N)
  7. }

. matrix list R, format(%12.1f)

